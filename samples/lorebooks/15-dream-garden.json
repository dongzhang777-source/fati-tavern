      ],
      "secondary_keys": [],
      "content": "园丁是自愿留在梦里的人，修剪失控的梦境、照料迷途者。他们的身体在现实里沉睡，靠亲友的探望维生。",
      "enabled": true,
      "insertion_order": 3,
      "position": "before_char",
      "constant": false,
      "case_sensitive": false
    },
    {
