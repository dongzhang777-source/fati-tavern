      "secondary_keys": [],
      "content": "锦衣卫缇骑遍布京城，明面上缉盗，暗地里监察百官。官员们私下说：家里的仆人都得查三代。",
      "enabled": true,
      "insertion_order": 3,
      "position": "before_char",
      "constant": false,
      "case_sensitive": false
    },
